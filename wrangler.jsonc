{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkup",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SQUADS", "class_name": "Squad" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Squad"] }],
  // Request logs are off on purpose: request addresses can carry member tokens.
  "observability": { "enabled": false }
}
